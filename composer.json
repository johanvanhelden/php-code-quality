{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "johanvanhelden/php-code-quality",
    "description": "A highly personal and opinionated set of PHP code quality rules and configurations",
    "license": "MIT",
    "keywords": [
        "php",
        "code-quality",
        "phpcs",
        "php-cs-fixer",
        "phpstan",
        "laravel"
    ],
    "authors": [
        {
            "name": "Johan van Helden",
            "email": "johan@johanvanhelden.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.10",
        "rector/rector": "^2.8",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "JohanVanHelden\\PhpCodeQuality\\PHPStan\\": "rules/phpstan/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test:syntax:pass": "find tests/syntax/pass -name '*.php' -print0 | xargs -0 -n1 -P8 php -l",
        "test:syntax:fail": "! find tests/syntax/fail -name '*.php' -print0 | xargs -0 -n1 -P8 php -l 2>&1",
        "test:syntax": [
            "@test:syntax:pass",
            "@test:syntax:fail"
        ],
        "test:stan:pass": "phpstan analyse --memory-limit=2G --configuration=tests/phpstan.neon tests/phpstan/pass -v",
        "test:stan:fail": "! phpstan analyse --memory-limit=2G --configuration=tests/phpstan.neon tests/phpstan/fail -v 2>&1",
        "test:stan:disallowed:pass": "cd tests/disallowed && ../../vendor/bin/phpstan analyse --memory-limit=2G --configuration=phpstan.neon app/Pass app/Helpers app/EnvFail -v",
        "test:stan:disallowed:fail": "tests/disallowed/assert-errors.sh phpstan.neon app/Fail 'remove debugging calls' 3",
        "test:stan:disallowed:environment:pass": "cd tests/disallowed && ../../vendor/bin/phpstan analyse --memory-limit=2G --configuration=phpstan-environment.neon app/Pass app/Helpers app/EnvPass -v",
        "test:stan:disallowed:environment:fail": "tests/disallowed/assert-errors.sh phpstan-environment.neon app/EnvFail 'Use App\\Helpers\\Environment' 10",
        "test:stan:disallowed": [
            "@test:stan:disallowed:pass",
            "@test:stan:disallowed:fail",
            "@test:stan:disallowed:environment:pass",
            "@test:stan:disallowed:environment:fail"
        ],
        "test:stan": [
            "@test:stan:pass",
            "@test:stan:fail",
            "@test:stan:disallowed"
        ],
        "test:cs:pass": "phpcs --standard=tests/phpcs.xml -ps tests/phpcs/pass tests/disallowed",
        "test:cs:fail": "! phpcs --standard=tests/phpcs.xml -ps tests/phpcs/fail 2>&1",
        "test:cs": [
            "@test:cs:pass",
            "@test:cs:fail"
        ],
        "test:cs-fix:pass": "php-cs-fixer fix --dry-run --diff --config=tests/.php-cs-fixer.php --path-mode=intersection tests/php-cs-fixer/pass tests/disallowed",
        "test:cs-fix:fail": "bash -c 'output=$(php-cs-fixer fix --dry-run --diff --config=tests/.php-cs-fixer.php --path-mode=intersection tests/php-cs-fixer/fail 2>&1); echo \"$output\"; ! echo \"$output\" | grep -q \"Found 0 of\"'",
        "test:cs-fix": [
            "@test:cs-fix:pass",
            "@test:cs-fix:fail"
        ],
        "test:config": [
            "@test:config:syntax",
            "@test:config:stan",
            "@test:config:cs-fix"
        ],
        "test:config:syntax": "find tests rules \\( -name '.php-cs-fixer.php' -o -name 'rector.php' \\) | xargs -n1 php -l",
        "test:config:stan": "phpstan analyse --memory-limit=2G --configuration=tests/phpstan.neon tests/.php-cs-fixer.php rules/.php-cs-fixer.php tests/rector.php rules/rector.php",
        "test:config:cs-fix": "php-cs-fixer fix --dry-run --diff --config=tests/.php-cs-fixer.php tests/.php-cs-fixer.php rules/.php-cs-fixer.php tests/rector.php rules/rector.php",
        "test:rector:pass": "rector process --dry-run --config=tests/rector.php tests/rector/pass",
        "test:rector:fail": "! rector process --dry-run --config=tests/rector.php tests/rector/fail 2>&1",
        "test:rector": [
            "@test:rector:pass",
            "@test:rector:fail"
        ],
        "test": [
            "@test:config",
            "@test:syntax",
            "@test:stan",
            "@test:cs",
            "@test:cs-fix",
            "@test:rector"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
